{
  "name": "discord-guildport",
  "version": "0.1.0-alpha.3",
  "description": "A terminal client for permission-checked GuildPort Discord relays",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dcgp": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "discord",
    "cli",
    "guildport",
    "relay"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "commander": "^15.0.0",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@xterm/headless": "^6.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Whiterzi/discord-guildport.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/Whiterzi/discord-guildport/issues"
  },
  "homepage": "https://github.com/Whiterzi/discord-guildport#readme"
